{
  "name": "vaquia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mts",
    "admin:create-company": "node --env-file-if-exists=.env.local scripts/create-company.mts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "node scripts/dbmate.mjs --wait up",
    "db:rollback": "node scripts/dbmate.mjs rollback",
    "db:new": "node scripts/dbmate.mjs new",
    "db:reset": "node scripts/dbmate.mjs drop && node scripts/dbmate.mjs up && pnpm db:seed",
    "db:auth-schema": "node --env-file-if-exists=.env.local scripts/print-auth-schema.mjs \"$PWD/src/lib/auth-options.ts\""
  },
  "dependencies": {
    "better-auth": "^1.7.10",
    "clsx": "^2.1.1",
    "geist": "^1.8.1",
    "next": "16.4.2",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dbmate": "^2.36.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
