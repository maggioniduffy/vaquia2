# Local: Postgres from `docker compose up -d`. Neon: use the *pooled* connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaquia?sslmode=disable
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional. Without it, magic links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Vaquia <no-reply@example.com>"
